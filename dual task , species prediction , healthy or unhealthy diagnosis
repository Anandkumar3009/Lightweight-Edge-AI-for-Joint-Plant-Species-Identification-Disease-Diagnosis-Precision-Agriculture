{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":3511727}],"dockerImageVersionId":31401,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":true}},"nbformat_minor":4,"nbformat":4,"cells":[{"source":"<a href=\"https://www.kaggle.com/code/saitejaswinichikoti/dualtask-hu-species-complete-notebook?scriptVersionId=345776989\" target=\"_blank\"><img align=\"left\" alt=\"Kaggle\" title=\"Open in Kaggle\" src=\"https://kaggle.com/static/images/open-in-kaggle.svg\"></a>","metadata":{},"cell_type":"markdown"},{"cell_type":"code","source":"# ============================================================\n# 1. IMPORTS & SETUP\n# ============================================================\nimport os\nimport re\nimport cv2\nimport numpy as np\nimport pandas as pd\nfrom PIL import Image\nfrom tqdm import tqdm\nimport matplotlib.pyplot as plt\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader\nfrom torch.utils.data.sampler import WeightedRandomSampler\nimport torchvision.transforms as transforms\nimport torchvision.models as models\n\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import classification_report, matthews_corrcoef","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-08-29T06:41:48.271843Z","iopub.execute_input":"2026-08-29T06:41:48.272247Z","iopub.status.idle":"2026-08-29T06:41:58.771745Z","shell.execute_reply.started":"2026-08-29T06:41:48.272219Z","shell.execute_reply":"2026-08-29T06:41:58.770815Z"}},"outputs":[],"execution_count":1},{"cell_type":"code","source":"# Kaggle Dataset Pathing Configurations\nDATASET_ROOT = \"/kaggle/input/datasets/amandam1/healthy-vs-diseased-leaf-image-dataset/A Database of Leaf Images\"\n\n# Scale batch size for dual T4 GPU distribution (32 images per GPU per step)\nBATCH_SIZE = 64  \nNUM_WORKERS = 4  # Boosted workers to feed dual GPUs smoothly without I/O bottlenecks\nNUM_EPOCHS = 20  \nLR = 1e-4\nIMG_SIZE = 224\n\nNUM_SPECIES_CLASSES = 12\nNUM_DISEASE_CLASSES = 2\n\nSPECIES_TO_LABEL = {\n    \"Alstonia Scholaris\": 0, \"Arjun\": 1, \"Bael\": 2, \"Basil\": 3,\n    \"Chinar\": 4, \"Gauva\": 5, \"Jamun\": 6, \"Jatropha\": 7,\n    \"Lemon\": 8, \"Mango\": 9, \"Pomegranate\": 10, \"Pongamia Pinnata\": 11\n}\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-29T06:41:58.773728Z","iopub.execute_input":"2026-08-29T06:41:58.774209Z","iopub.status.idle":"2026-08-29T06:41:58.779018Z","shell.execute_reply.started":"2026-08-29T06:41:58.77418Z","shell.execute_reply":"2026-08-29T06:41:58.778357Z"}},"outputs":[],"execution_count":2},{"cell_type":"code","source":"# ============================================================\n# 2. DATA AUGMENTATION: SENSOR NOISE & MULTI-ANGLE INVARIANCE\n# ============================================================\nclass AddGaussianNoise(object):\n    \"\"\"Simulates raw, low-cost camera sensor noise seen in live field monitoring.\"\"\"\n    def __init__(self, mean=0.0, std=0.03, p=0.5):\n        self.std = std\n        self.mean = mean\n        self.p = p\n        \n    def __call__(self, tensor):\n        if torch.rand(1).item() > self.p:\n            return tensor\n        return tensor + torch.randn(tensor.size()) * self.std + self.mean\n\ntrain_transforms = transforms.Compose([\n    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n    transforms.RandomHorizontalFlip(p=0.5),\n    transforms.RandomVerticalFlip(p=0.5),\n    transforms.RandomRotation(degrees=180), # Perfect 360-degree rotation resilience\n    transforms.RandomAffine(\n        degrees=0, translate=(0.15, 0.15), scale=(0.8, 1.2), shear=15, fill=255\n    ),\n    transforms.ColorJitter(\n        brightness=0.4, contrast=0.4, saturation=0.3, hue=0.15 # Outdoor light simulation\n    ),\n    transforms.ToTensor(),\n    AddGaussianNoise(mean=0.0, std=0.03, p=0.5), # Protects model from camera sensor artifacts\n    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n])\n\ntest_transforms = transforms.Compose([\n    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n    transforms.ToTensor(),\n    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-29T06:41:58.780031Z","iopub.execute_input":"2026-08-29T06:41:58.780372Z","iopub.status.idle":"2026-08-29T06:41:58.793154Z","shell.execute_reply.started":"2026-08-29T06:41:58.78035Z","shell.execute_reply":"2026-08-29T06:41:58.792351Z"}},"outputs":[],"execution_count":3},{"cell_type":"code","source":"# ============================================================\n# 3. RAW DATA ENGINE & STRATIFIED INGESTION (FULLY FIXED)\n# ============================================================\nprint(\"Gathering raw image assets directly from source directory map...\")\nIMAGE_EXTS = {'.jpg', '.jpeg', '.png', '.bmp', '.tiff', '.webp'}\nall_rows = []\n\nfor plant_folder in sorted(os.listdir(DATASET_ROOT)):\n    plant_path = os.path.join(DATASET_ROOT, plant_folder)\n    if not os.path.isdir(plant_path): continue\n    species_name = re.sub(r'\\(P\\d+\\)', '', plant_folder).strip()\n    if species_name not in SPECIES_TO_LABEL: continue\n    species_label = SPECIES_TO_LABEL[species_name]\n\n    for condition in [\"healthy\", \"diseased\"]:\n        condition_path = os.path.join(plant_path, condition)\n        if not os.path.isdir(condition_path): continue\n        disease_label = 1 if condition == \"diseased\" else 0\n        \n        # This explicit line index completely bypasses the tuple attribute error\n        images = [f for f in os.listdir(condition_path) if f.lower().endswith(tuple(IMAGE_EXTS))]\n        \n        for img_name in images:\n            all_rows.append({\n                \"image_path\": os.path.join(condition_path, img_name),\n                \"species_label\": species_label,\n                \"disease_label\": disease_label\n            })\n\ndf_all = pd.DataFrame(all_rows)\ndf_all[\"strat_key\"] = df_all[\"species_label\"].astype(str) + \"_\" + df_all[\"disease_label\"].astype(str)\n\n# Stratified Split 70/15/15\ndf_train, df_temp = train_test_split(df_all, test_size=0.30, random_state=42, stratify=df_all[\"strat_key\"])\ndf_val, df_test = train_test_split(df_temp, test_size=0.50, random_state=42, stratify=df_temp[\"strat_key\"])\n\nclass PlantDataset(Dataset):\n    def __init__(self, df, transform=None):\n        self.df = df.reset_index(drop=True)\n        self.transform = transform\n    def __len__(self): return len(self.df)\n    def __getitem__(self, idx):\n        row = self.df.iloc[idx]\n        image = Image.open(row[\"image_path\"]).convert(\"RGB\")\n        if self.transform: image = self.transform(image)\n        return image, torch.tensor(int(row[\"species_label\"]), dtype=torch.long), torch.tensor(int(row[\"disease_label\"]), dtype=torch.long)\n\ntrain_dataset = PlantDataset(df_train, transform=train_transforms)\nval_dataset   = PlantDataset(df_val,   transform=test_transforms)\ntest_dataset  = PlantDataset(df_test,  transform=test_transforms)\n\n# Balanced Class Sampler Execution\nspecies_targets = train_dataset.df[\"species_label\"].values\nclass_counts = np.bincount(species_targets)\nsampler = WeightedRandomSampler(1.0 / class_counts[species_targets], len(species_targets), replacement=True)\n\ntrain_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, sampler=sampler, num_workers=NUM_WORKERS, pin_memory=True)\nvalid_loader = DataLoader(val_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS, pin_memory=True)\ntest_loader  = DataLoader(test_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS, pin_memory=True)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-29T06:41:58.793955Z","iopub.execute_input":"2026-08-29T06:41:58.794212Z","iopub.status.idle":"2026-08-29T06:41:59.04645Z","shell.execute_reply.started":"2026-08-29T06:41:58.794192Z","shell.execute_reply":"2026-08-29T06:41:59.045825Z"}},"outputs":[{"name":"stdout","text":"Gathering raw image assets directly from source directory map...\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"# ============================================================\n# 4. DEEP DUAL-ATTENTION NETWORK ARCHITECTURE (CORRECTED)\n# ============================================================\nclass ChannelAttention(nn.Module):\n    def __init__(self, channels, reduction=16):\n        super().__init__()\n        self.avg_pool = nn.AdaptiveAvgPool2d(1)\n        self.max_pool = nn.AdaptiveMaxPool2d(1)\n        self.fc = nn.Sequential(\n            nn.Conv2d(channels, channels // reduction, 1), nn.ReLU(),\n            nn.Conv2d(channels // reduction, channels, 1)\n        )\n        self.sigmoid = nn.Sigmoid()\n    def forward(self, x): return self.sigmoid(self.fc(self.avg_pool(x)) + self.fc(self.max_pool(x)))\n\nclass SpatialAttention(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.conv = nn.Conv2d(2, 1, kernel_size=7, padding=3)\n        self.sigmoid = nn.Sigmoid()\n        \n    def forward(self, x):\n        # torch.mean returns a clean tensor\n        mean_out = torch.mean(x, dim=1, keepdim=True)\n        \n        # torch.amax ONLY returns the maximum values as a clean tensor (no indices tuple!)\n        max_out = torch.amax(x, dim=1, keepdim=True)\n        \n        # Concat the two clean tensors together perfectly\n        combined = torch.cat([mean_out, max_out], dim=1)\n        \n        return self.sigmoid(self.conv(combined))\n\nclass CBAM(nn.Module):\n    def __init__(self, channels):\n        super().__init__()\n        self.ca, self.sa = ChannelAttention(channels), SpatialAttention()\n    def forward(self, x): return x * self.ca(x) * self.sa(x)\n\nclass CrossAttention(nn.Module):\n    def __init__(self, dim):\n        super().__init__()\n        self.query, self.key, self.value = nn.Linear(dim, dim), nn.Linear(dim, dim), nn.Linear(dim, dim)\n        self.scale = dim ** -0.5\n    def forward(self, x1, x2):\n        Q, K, V = self.query(x1), self.key(x2), self.value(x2)\n        return torch.matmul(torch.softmax(torch.matmul(Q, K.transpose(-2, -1)) * self.scale, dim=-1), V)\n\nclass MultiTaskPlantModel(nn.Module):\n    def __init__(self):\n        super().__init__()\n        backbone = models.mobilenet_v3_large(weights=models.MobileNet_V3_Large_Weights.DEFAULT)\n        self.features = backbone.features\n        self.cbam = CBAM(960)\n        self.pool = nn.AdaptiveAvgPool2d(1)\n        self.shared_fc = nn.Sequential(nn.Linear(960, 512), nn.ReLU(), nn.Dropout(0.3))\n        self.species_fc, self.disease_fc = nn.Linear(512, 256), nn.Linear(512, 256)\n        self.cross_attention = CrossAttention(256)\n        self.species_classifier = nn.Linear(256, NUM_SPECIES_CLASSES)\n        self.disease_classifier = nn.Linear(256, NUM_DISEASE_CLASSES)\n\n    def forward(self, x):\n        x = self.pool(self.cbam(self.features(x))).flatten(1)\n        shared = self.shared_fc(x)\n        sf, df = self.species_fc(shared), self.disease_fc(shared)\n        sf = sf + self.cross_attention(sf.unsqueeze(1), df.unsqueeze(1)).squeeze(1)\n        df = df + self.cross_attention(df.unsqueeze(1), sf.unsqueeze(1)).squeeze(1)\n        return self.species_classifier(sf), self.disease_classifier(df)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-29T06:41:59.047568Z","iopub.execute_input":"2026-08-29T06:41:59.047954Z","iopub.status.idle":"2026-08-29T06:41:59.061931Z","shell.execute_reply.started":"2026-08-29T06:41:59.047922Z","shell.execute_reply":"2026-08-29T06:41:59.061286Z"}},"outputs":[],"execution_count":5},{"cell_type":"code","source":"# ============================================================\n# 5. EXPLICIT INITIAL FREEZE & ENGINE CONFIGURATION\n# ============================================================\nraw_model = MultiTaskPlantModel()\n\n# ---- THE INITIAL FREEZE ----\n# We explicitly step through and turn off gradient updates for the first 40 structural layers\nprint(\"\\n[!] Initializing Stage 1: Explicitly locking the first 40 backbone layers...\")\nfor name, param in list(raw_model.features.named_parameters())[:40]:\n    param.requires_grad = False\n\n# Wrap model using PyTorch DataParallel to activate BOTH Kaggle T4 GPUs\nif torch.cuda.device_count() > 1:\n    print(f\">> Critical Engine Status: Detected {torch.cuda.device_count()} GPUs. Activating DataParallel parallelization!\")\n    model = nn.DataParallel(raw_model)\nelse:\n    model = raw_model\n\n# Direct unified execution device anchor\nDEVICE = torch.device(\"cuda:0\" if torch.cuda.is_available() else \"cpu\")\nmodel.to(DEVICE)\n\nspecies_criterion = nn.CrossEntropyLoss()\ndisease_criterion = nn.CrossEntropyLoss()\n\n# Filter ensures our baseline optimizer only maps to tracking layers that are still open (requires_grad=True)\noptimizer = torch.optim.AdamW(filter(lambda p: p.requires_grad, model.parameters()), lr=LR)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-29T06:41:59.062839Z","iopub.execute_input":"2026-08-29T06:41:59.063114Z","iopub.status.idle":"2026-08-29T06:42:00.107077Z","shell.execute_reply.started":"2026-08-29T06:41:59.063083Z","shell.execute_reply":"2026-08-29T06:42:00.10627Z"}},"outputs":[{"name":"stdout","text":"Downloading: \"https://download.pytorch.org/models/mobilenet_v3_large-5c1a4163.pth\" to /root/.cache/torch/hub/checkpoints/mobilenet_v3_large-5c1a4163.pth\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 21.1M/21.1M [00:00<00:00, 145MB/s] \n","output_type":"stream"},{"name":"stdout","text":"\n[!] Initializing Stage 1: Explicitly locking the first 40 backbone layers...\n>> Critical Engine Status: Detected 2 GPUs. Activating DataParallel parallelization!\n","output_type":"stream"}],"execution_count":6},{"cell_type":"code","source":"# ============================================================\n# 6. TRAINING & VALIDATION PARALLEL ENGINE (WITH AUTO-UNFREEZE)\n# ============================================================\ntrain_losses = []\nval_losses = []\nbest_val_score = -1.0\nUNFREEZE_EPOCH = 5  # Switch flipped at Epoch 5 to lift layer freezes\n\nfor epoch in range(NUM_EPOCHS):\n    print(f\"\\n======== Epoch {epoch+1}/{NUM_EPOCHS} ========\")\n    \n    # --- AUTO-UNFREEZE TRIGGER ---\n    if epoch + 1 == UNFREEZE_EPOCH:\n        print(\"\\n[!] STABILITY SIGNAL ENCOUNTERED: Explicitly unlocking all backbone layers for sensor alignment...\")\n        \n        # Turn gradient updates back ON for all backbone parameters\n        for param in raw_model.features.parameters():\n            param.requires_grad = True\n            \n        # Re-link the optimizer with split parameter tracking & a lower learning rate for the backbone\n        optimizer = torch.optim.AdamW([\n            {'params': raw_model.features.parameters(), 'lr': 1e-5}, # Protected fine-tuning rate\n            {'params': raw_model.cbam.parameters(), 'lr': LR},\n            {'params': raw_model.cross_attention.parameters(), 'lr': LR},\n            {'params': raw_model.species_classifier.parameters(), 'lr': LR},\n            {'params': raw_model.disease_classifier.parameters(), 'lr': LR}\n        ])\n        print(\">> Optimizer reset achieved with differential learning rates.\")\n\n    # TRAINING STEP\n    model.train()\n    running_train_loss = 0.0\n    for images, species_labels, disease_labels in tqdm(train_loader, desc=\"Training Batches\"):\n        images, species_labels, disease_labels = images.to(DEVICE), species_labels.to(DEVICE), disease_labels.to(DEVICE)\n        \n        optimizer.zero_grad()\n        species_logits, disease_logits = model(images)\n        loss = species_criterion(species_logits, species_labels) + disease_criterion(disease_logits, disease_labels)\n        \n        loss.backward()\n        optimizer.step()\n        running_train_loss += loss.item()\n        \n    epoch_train_loss = running_train_loss / len(train_loader)\n    train_losses.append(epoch_train_loss)\n    print(f\"Parallel Train Combined Loss: {epoch_train_loss:.4f}\")\n    \n    # VALIDATION STEP\n    model.eval()\n    running_val_loss = 0.0\n    val_s_preds, val_s_targets = [], []\n    val_d_preds, val_d_targets = [], []\n    \n    with torch.no_grad():\n        for images, species_labels, disease_labels in valid_loader:\n            images, species_labels, disease_labels = images.to(DEVICE), species_labels.to(DEVICE), disease_labels.to(DEVICE)\n            species_logits, disease_logits = model(images)\n            \n            loss = species_criterion(species_logits, species_labels) + disease_criterion(disease_logits, disease_labels)\n            running_val_loss += loss.item()\n            \n            val_s_preds.extend(torch.argmax(species_logits, dim=1).cpu().numpy())\n            val_s_targets.extend(species_labels.cpu().numpy())\n            val_d_preds.extend(torch.argmax(disease_logits, dim=1).cpu().numpy())\n            val_d_targets.extend(disease_labels.cpu().numpy())\n            \n    epoch_val_loss = running_val_loss / len(valid_loader)\n    val_losses.append(epoch_val_loss)\n    print(f\"Parallel Val Combined Loss:  {epoch_val_loss:.4f}\")\n    \n    # Calculate Robust Evaluation Components\n    s_f1 = classification_report(val_s_targets, val_s_preds, output_dict=True, zero_division=0)['macro avg']['f1-score']\n    d_f1 = classification_report(val_d_targets, val_d_preds, output_dict=True, zero_division=0)['macro avg']['f1-score']\n    s_mcc = matthews_corrcoef(val_s_targets, val_s_preds)\n    d_mcc = matthews_corrcoef(val_d_targets, val_d_preds)\n    \n    # Track metrics and save the pristine raw single-GPU configuration\n    combined_score = (s_f1 + s_mcc + d_f1 + d_mcc) / 4.0\n    if combined_score > best_val_score:\n        best_val_score = combined_score\n        target_model_state = raw_model.state_dict() if isinstance(model, nn.DataParallel) else model.state_dict()\n        torch.save(target_model_state, \"best_model_robust.pth\")\n        print(\">> Validation performance index spiked. Updated 'best_model_robust.pth' successfully.\")\n\n# ============================================================\n# 7. AUTOMATED GRAPH GENERATION\n# ============================================================\nplt.figure(figsize=(10, 6))\nplt.plot(range(1, NUM_EPOCHS + 1), train_losses, label='Training Loss', color='#1f77b4', linewidth=2.5)\nplt.plot(range(1, NUM_EPOCHS + 1), val_losses, label='Validation Loss', color='#ff7f0e', linewidth=2.5)\nplt.title('Multi-Task Learning Loss Profile Across Dual T4 GPUs', fontsize=12, fontweight='bold')\nplt.xlabel('Epochs', fontsize=10)\nplt.ylabel('Total Multi-Task Loss (Cross-Entropy Stack)', fontsize=10)\nplt.grid(True, linestyle='--', alpha=0.5)\nplt.legend(fontsize=10)\nplt.tight_layout()\nplt.savefig('loss_vs_epochs_plot.png', dpi=300)\nplt.show()\n\nprint(\"\\nAll tasks finalized successfully. Model weights and graphics stored safely in Kaggle output environment.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-29T06:42:00.109556Z","iopub.execute_input":"2026-08-29T06:42:00.110313Z","execution_failed":"2026-08-29T08:50:53.824Z"}},"outputs":[{"name":"stdout","text":"\n======== Epoch 1/20 ========\n","output_type":"stream"},{"name":"stderr","text":"Training Batches: 100%|██████████| 47/47 [06:19<00:00,  8.08s/it]","output_type":"stream"},{"name":"stdout","text":"Parallel Train Combined Loss: 2.7