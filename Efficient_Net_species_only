rt torch\nimport torch.nn as nn\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport cv2\nfrom torchvision import models, transforms\nfrom PIL import Image\n\nclass HistogramEqualization:\n    def __init__(self, clip_limit=2.0, tile_size=(8, 8)):\n        self.clip_limit = clip_limit\n        self.tile_size = tile_size\n\n    def __call__(self, img):\n        img_array = np.array(img)\n        img_bgr = cv2.cvtColor(img_array, cv2.COLOR_RGB2BGR)\n        img_lab = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2LAB)\n        clahe = cv2.createCLAHE(\n            clipLimit=self.clip_limit,\n            tileGridSize=self.tile_size\n        )\n        img_lab[:, :, 0] = clahe.apply(img_lab[:, :, 0])\n        img_bgr = cv2.cvtColor(img_lab, cv2.COLOR_LAB2BGR)\n        img_rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)\n        return Image.fromarray(img_rgb)\n\nuntrained_preprocess = transforms.Compose([\n    transforms.Resize((224, 224)),\n    transforms.Lambda(lambda img: img.convert('RGB')),\n    transforms.ToTensor(),\n    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n])\n\ntrained_preprocess = transforms.Compose([\n    transforms.Resize((224, 224)),\n    transforms.Lambda(lambda img: img.convert('RGB')),\n    HistogramEqualization(clip_limit=2.0, tile_size=(8, 8)),\n    transforms.ToTensor(),\n    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n])\n\nNUM_CLASSES = 93\nPTH_PATH = '/kaggle/input/datasets/saitejaswinichikoti/efficientnet-model/efficientnet_medicinal_plants.pth'  # <-- replace with your path\ndevice = torch.device(\"cuda:0\" if torch.cuda.is_available() else \"cpu\")\n\n\ndef visualize_feature_maps(image_path, use_trained=False):\n    # Load model\n    model = models.efficientnet_b0(weights=None)\n    if use_trained:\n        # Match the same classifier replacement done during training\n        num_ftrs = model.classifier[1].in_features\n        model.classifier = nn.Linear(num_ftrs, NUM_CLASSES)\n        model.load_state_dict(torch.load(PTH_PATH, map_location=device))\n        preprocess = trained_preprocess\n        title_prefix = \"Trained EfficientNet-B0\"\n    else:\n        preprocess = untrained_preprocess\n        title_prefix = \"Untrained EfficientNet-B0\"\n\n    model = model.to(device)\n    model.eval()\n\n    # Preprocess image\n    img = Image.open(image_path).convert('RGB')\n    img_tensor = preprocess(img).unsqueeze(0).to(device)\n\n    # EfficientNet-B0 features block indices:\n    # 0 = Stem Conv\n    # 1 = Stage 1 (1x MBConv, 16ch)\n    # 2 = Stage 2 (2x MBConv, 24ch)\n    # 3 = Stage 3 (2x MBConv, 40ch)\n    # 4 = Stage 4 (3x MBConv, 80ch)\n    # 5 = Stage 5 (3x MBConv, 112ch)\n    # 6 = Stage 6 (4x MBConv, 192ch)\n    # 7 = Stage 7 (1x MBConv, 320ch)\n    # 8 = Head Conv (1280ch)\n    ixs = [0, 2, 4, 6, 8]  # stem, early, mid, deep, head\n\n    feature_maps = {}\n    hooks = []\n\n    for ix in ixs:\n        def make_hook(i):\n            def hook(module, input, output):\n                feature_maps[f'features_{i}'] = output.detach().cpu()\n            return hook\n        hooks.append(model.features[ix].register_forward_hook(make_hook(ix)))\n\n    with torch.no_grad():\n        model(img_tensor)\n\n    for h in hooks:\n        h.remove()\n\n    # Plot — 8x8 grid per layer\n    square = 8\n    img_name = image_path.split(\"/\")[-1]\n\n    layer_labels = {\n        'features_0': 'Stem Conv (32ch)',\n        'features_2': 'Stage 2 MBConv (24ch)',\n        'features_4': 'Stage 4 MBConv (80ch)',\n        'features_6': 'Stage 6 MBConv (192ch)',\n        'features_8': 'Head Conv (1280ch)',\n    }\n\n    for layer_name, fmap in feature_maps.items():\n        fmap = fmap[0]\n        n_filters = min(64, fmap.shape[0])\n        fig, axes = plt.subplots(square, square, figsize=(12, 12))\n        label = layer_labels.get(layer_name, layer_name)\n        fig.suptitle(\n            f'{title_prefix} — {label} — {img_name}', fontsize=13\n        )\n        ix = 0\n        for i in range(square):\n            for j in range(square):\n                ax = axes[i, j]\n                ax.set_xticks([])\n                ax.set_yticks([])\n                if ix < n_filters:\n                    f = fmap[ix].numpy()\n                    f = (f - f.min()) / (f.max() - f.min() + 1e-8)\n                    ax.imshow(f, cmap='gray')\n                else:\n                    ax.axis('off')\n                ix += 1\n        plt.tight_layout()\n        plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-02T09:39:22.232188Z","iopub.execute_input":"2026-06-02T09:39:22.23251Z","iopub.status.idle":"2026-06-02T09:39:35.463575Z","shell.execute_reply.started":"2026-06-02T09:39:22.232484Z","shell.execute_reply":"2026-06-02T09:39:35.462653Z"}},"outputs":[],"execution_count":1},{"cell_type":"code","source":"visualize_feature_maps('/kaggle/input/datasets/saitejaswinichikoti/merged-dataset/azadirachta_indica/df2_AI-S-013.jpg', use_trained=True)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-02T09:39:40.795747Z","iopub.execute_input":"2026-06-02T09:39:40.796091Z","iopub.status.idle":"2026-06-02T09:39:49.924632Z","shell.execute_reply.started":"2026-06-02T09:39:40.79606Z","shell.execute_reply":"2026-06-02T09:39:49.923974Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x1200 with 64 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x1200 with 64 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x1200 with 64 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x1200 with 64 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x1200 with 64 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":2},{"cell_type":"code","source"